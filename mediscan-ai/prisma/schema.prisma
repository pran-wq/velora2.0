datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id          String      @id @default(cuid())
  patientName String
  age         Int
  gender      String
  reportText  String
  diseases    String
  severity    String
  confidence  Float
  summary     String
  createdAt   DateTime    @default(now())
  biomarkers  Biomarker[]
}

model Biomarker {
  id        String @id @default(cuid())
  reportId  String
  name      String
  value     Float
  unit      String
  status    String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
